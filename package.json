{
  "name": "flexui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "preview:build": "node scripts/build-preview.mjs",
    "predev": "npm run catalog:build && npm run webgl:assets && npm run preview:build",
    "prebuild": "npm run catalog:build && npm run webgl:assets && npm run preview:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint . --max-warnings=0",
    "registry:build": "node --import tsx scripts/build-registry.ts",
    "analyze": "npm run preview:build && ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:pages": "playwright test --config playwright.site.config.ts",
    "pretest": "npm run webgl:assets",
    "webgl:assets": "node scripts/flexui-webgl-assets.mjs --all",
    "catalog:build": "node --import tsx scripts/build-component-stats.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.37.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "ogl": "1.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "three-globe": "^2.45.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
