{
  "name": "flexui-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "esbuild src/code.ts --bundle --outfile=dist/code.js --watch & esbuild src/ui.tsx --bundle --outfile=dist/ui.js --loader:.tsx=tsx --watch",
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --minify && esbuild src/ui.tsx --bundle --outfile=dist/ui.js --loader:.tsx=tsx --minify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
